{
  "name": "SH103 Lab - Nhắc Việc Ca Trực (Zalo / Email / Telegram)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 10,13,15,21 * * *"
            }
          ]
        }
      },
      "id": "1",
      "name": "Lịch hẹn kiểm tra ca trực (10:30, 13:00, 15:30, 21:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "https://sh103-lab.vercel.app/api/webhooks/n8n/shift-reminder",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Gọi Webhook Kiểm Tra Tiến Độ Ca Trực",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.needs_reminder }}",
              "value2": true
            }
          ]
        }
      },
      "id": "3",
      "name": "Còn mục chưa hoàn tất?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "chatId": "@khoasinhhoa103",
        "text": "={{ $json.summary_message }}",
        "additionalFields": {}
      },
      "id": "4",
      "name": "Đẩy thông báo Telegram (Kênh / Nhóm)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [940, 200]
    },
    {
      "parameters": {
        "fromEmail": "khoasinhhoa103@gmail.com",
        "toEmail": "bacsi.sinhhoa@sh103.hospital",
        "subject": "=📢 [BV103] Nhắc việc ca trực {{ $json.shift.label }} - {{ $json.date }}",
        "text": "={{ $json.summary_message }}"
      },
      "id": "5",
      "name": "Gửi Email Nhắc Việc",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [940, 400]
    }
  ],
  "connections": {
    "Lịch hẹn kiểm tra ca trực (10:30, 13:00, 15:30, 21:00)": {
      "main": [
        [
          {
            "node": "Gọi Webhook Kiểm Tra Tiến Độ Ca Trực",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gọi Webhook Kiểm Tra Tiến Độ Ca Trực": {
      "main": [
        [
          {
            "node": "Còn mục chưa hoàn tất?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Còn mục chưa hoàn tất?": {
      "main": [
        [
          {
            "node": "Đẩy thông báo Telegram (Kênh / Nhóm)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Gửi Email Nhắc Việc",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
